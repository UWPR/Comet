    <!--
      RAWReader.cpp (from MSToolkit, unmodified) is compiled directly in this project rather than
      in MSToolkitCore: a C++/CLI file with CLRSupport=NetCore cannot live in a StaticLibrary
      project (MSBuild error NETSDK1116), only in a DynamicLibrary/Application, which this project
      already is. See the comment in MSToolkitCore.vcxproj for the full rationale. This keeps
      Thermo .raw support in CometWrapperCore at parity with the Framework CometWrapper build.
    -->
    <ClCompile Include="..\MSToolkit\src\MSToolkit\RAWReader.cpp">
      <ObjectFileName>$(IntDir)RAWReader.obj</ObjectFileName>
      <PrecompiledHeader Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">NotUsing</PrecompiledHeader>
      <PrecompiledHeader Condition="'$(Configuration)|$(Platform)'=='Release|x64'">NotUsing</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <!--
    Same HintPath approach as MSToolkit.vcxproj/docs/20260618_RawFileReaderMigration.md:
    PackageReference does not resolve cleanly for a native-style vcxproj. Points at the same
    repo-local package cache MSToolkit.vcxproj already restores into.
  -->
  <PropertyGroup>
    <ThermoNuGetCache>$(SolutionDir)packages\thermofisher.commoncore.</ThermoNuGetCache>
    <ThermoVersion>5.0.0.93</ThermoVersion>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ThermoFisher.CommonCore.Data">
      <HintPath>$(ThermoNuGetCache)data\$(ThermoVersion)\lib\netstandard2.0\ThermoFisher.CommonCore.Data.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="ThermoFisher.CommonCore.RawFileReader">
      <HintPath>$(ThermoNuGetCache)rawfilereader\$(ThermoVersion)\lib\netstandard2.0\ThermoFisher.CommonCore.RawFileReader.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
