  <!--
    MSToolkitCore is a plain-native sibling of MSToolkit for CometWrapperCore (net8.0) to link
    against. It compiles every MSToolkit source file EXCEPT RAWReader.cpp, unmodified, via
    relative Include paths back into ../MSToolkit; no source is duplicated or edited.

    RAWReader.cpp itself is intentionally NOT compiled here. It is classic-/clr-only-free (it does
    not require classic /clr specifically), but a C++/CLI file with CLRSupport=NetCore cannot
    live in a StaticLibrary project at all (MSBuild error NETSDK1116: "C++/CLI projects targeting
    .NET Core must be dynamic libraries"), so it cannot be given its own project-level netcore-CLR
    static-lib home the way MSToolkit.vcxproj hosts it for classic /clr. Instead, RAWReader.cpp is
    compiled directly inside CometWrapperCore.vcxproj (which is already a DynamicLibrary with
    CLRSupport=NetCore), alongside CometWrapper.cpp itself. RAWReader.h still declares the same
    plain-native RAWReader class (a native RAWReaderImpl* pImpl, per
    docs/20260618_RawFileReaderMigration.md) regardless of which project compiles RAWReader.cpp,
    so MSReader's layout here is unchanged and stays link-compatible with the existing, unmodified
    CometSearch.lib; Thermo .raw support is fully retained, just relocated to where /clr:netcore
    is actually allowed to live.
  -->
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <PreprocessorDefinitions>_DEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;XML_STATIC;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <AdditionalOptions>$(PreDef)</AdditionalOptions>
      <AdditionalIncludeDirectories>..\MSToolkit\include;..\MSToolkit\include\extern;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
